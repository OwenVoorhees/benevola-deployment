# Copy this file to api/.env and fill in the values.
#   cp api/.env.example api/.env
# api/.env is gitignored — never commit real secrets.

NODE_ENV=development

# The server listens on BE_PORT. FE_PORT and DOMAIN together build the CORS
# origin (`${DOMAIN}:${FE_PORT}`), which must match where the frontend runs,
# or the browser will drop the session cookie on every API call.
BE_PORT=5173
FE_PORT=3000
DOMAIN=http://localhost

# Required — express-session refuses to start without it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-random-64-char-hex-string

# Sessions are stored in Redis. In development the server falls back to an
# in-memory store when this is unreachable (sessions then reset on restart);
# in production it is required and startup fails without it.
REDIS_URL=redis://localhost:6379

# Image uploads (Cloudflare R2). Optional: leave blank and the app runs
# normally, but the upload buttons stay hidden and image fields are URL-only.
# All five must be set for uploads to switch on.
#
#   R2_ACCOUNT_ID       Cloudflare dashboard -> R2 -> "Account ID"
#   R2_BUCKET           the bucket name you created, e.g. benevola-uploads
#   R2_ACCESS_KEY_ID    R2 -> API -> Manage API Tokens -> Object Read & Write
#   R2_SECRET_ACCESS_KEY  shown once when the token is created
#   R2_PUBLIC_URL       public base URL for the bucket, no trailing slash.
#                       Either the r2.dev dev domain (fine for coursework) or
#                       a custom domain (needed for production traffic).
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# Optional — SQLite paths default to api/data/{dev,prod}.sqlite
# SQLITE_STORAGE_DEV=
# SQLITE_STORAGE_PROD=

# Optional — only needed if the Google sign-in route in src/routes/auth.js
# is uncommented.
# GOOGLE_CLIENT_ID=
